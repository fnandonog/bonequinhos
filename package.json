{
  "name": "bonequinhos",
  "private": true,
  "version": "0.1.0",
  "description": "Fábrica de vídeos de bonequinhos explicando como as coisas funcionam",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts",
    "tts": "python3 tools/tts.py",
